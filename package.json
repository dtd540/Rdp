{
  "name": "spott-experimental",
  "version": "0.3.6",
  "description": "Route Spotify or YouTube Music through VoiceMeeter into your VRChat microphone — one app, verified setup.",
  "main": "out/main/index.js",
  "author": "SPOTT",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dtd540/Rdp.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "sidecar:build": "dotnet publish sidecar/AudioBridge.Sidecar.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o sidecar/publish",
    "dist": "npm run build && npm run sidecar:build && electron-builder --win --x64",
    "release": "npm run build && npm run sidecar:build && electron-builder --win --x64 --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "dev.vcbridge.music",
    "productName": "SPOTT Experimental",
    "files": [
      "out/**",
      "shared/**",
      "docs/CHANGELOG.md",
      "build/spott-tray.png",
      "build/spott.png"
    ],
    "extraResources": [
      {
        "from": "sidecar/publish",
        "to": "sidecar"
      }
    ],
    "win": {
      "icon": "build/spott.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "SPOTT-Experimental-Setup-${version}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "installerIcon": "build/spott.ico",
      "uninstallerIcon": "build/spott.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "dtd540",
      "repo": "Rdp-releases",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
